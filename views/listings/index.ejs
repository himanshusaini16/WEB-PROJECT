<% layout("layout/boilerplate.ejs") -%>
  
    <div id="filters" >
      <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic cities</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Montains</p>
      </div>
      <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pool</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </div>
      <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
      <div class="filter ">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Artic</p>
      </div>
      <div class="filter ">
        <div><i class="fa-solid fa-sailboat"></i></div>
        <p>Boating</p>
      </div>
      <div class="filter ">
        <div><i class="fa-brands fa-cloudflare"></i></div>
        <p>Cloud point</p>
      </div>
      
      <div class="tax-switch ">
        <div class="form-check form-switch form-check-reverse">
          <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
          <label class="form-check-label" for="flexSwitchCheckDefault">25% Discount</label>
        </div>  
      </div>
    </div>
    <div class="container">
    <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>
                <a href="/listings/<%=listing._id%>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%=listing.image.url%>" class="card-img-top" alt="Listing image"  style="height: 20rem;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                          <h5 class="card-title"><%=listing.title%></h5>
                        <p class="original-price">₹<%=listing.price%><p class="tax-info">New Price:<%=listing.price - listing.price * 0.25%></p></p>
                        </div>
                      </div>
                </a>
              <% } %>
    </div> 
    </div>

    <script>
  document.getElementById("flexSwitchCheckDefault").addEventListener("change", function() {
    const checked = this.checked;
    const originalPrices = document.querySelectorAll(".original-price");
    const discountPrices = document.querySelectorAll(".tax-info");

    originalPrices.forEach((price, index) => {
      if (checked) {
        price.style.textDecoration = "line-through";
        price.style.color = "#f56c6c";
        discountPrices[index].style.display = "block";
      } else {
        price.style.textDecoration = "none";
        price.style.color = "black";
        discountPrices[index].style.display = "none";
      }
    });
  });
</script>


